[Unit]
Description=Video Recorder
After=network.target

[Service]
TimeoutStopSec=3s
RestartSec=10
ExecStart=/home/manager/turnstile_controller/venv/bin/python /home/manager/turnstile_controller/camera/videorecorder.py
User=manager
Restart=always
WorkingDirectory=/home/manager/turnstile_controller/


[Install]
WantedBy=multi-user.target