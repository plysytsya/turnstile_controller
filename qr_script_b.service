[Unit]
Description=My qr.py script B
After=network.target

[Service]
Environment="DIRECTION=B"
TimeoutStopSec=3
RestartSec=0
Restart=always
ExecStart=/root/turnstile_controller/.venv/bin/python3 /root/turnstile_controller/qr.py
User=root
WorkingDirectory=/root/turnstile_controller/


[Install]
WantedBy=multi-user.target
