[Unit]
Description=My qr.py script A
After=network.target

[Service]
Environment="DIRECTION=A"
TimeoutStopSec=3
RestartSec=0
Restart=always
ExecStart=/home/manager/turnstile_controller/venv/bin/python /home/manager/turnstile_controller/qr.py
User=manager
WorkingDirectory=/home/manager/turnstile_controller/


[Install]
WantedBy=multi-user.target
