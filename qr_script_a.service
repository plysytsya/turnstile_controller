[Unit]
Description=My qr.py script A
After=network.target

[Service]
Environment="DIRECTION=A"
TimeoutStopSec=3
RestartSec=0
Restart=always
ExecStart=/manager/home/turnstile_controller/.venv/bin/python3 /manager/home/turnstile_controller/qr.py
User=root
WorkingDirectory=/manager/home/turnstile_controller/


[Install]
WantedBy=multi-user.target
